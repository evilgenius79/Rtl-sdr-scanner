# Police Scanner — environment configuration.
# Copy to .env (chmod 600) and fill in.
#
# This file MUST never be committed. .gitignore excludes it.

# ───────── Web app ─────────
# Bind address. Use 127.0.0.1 if you put a TLS reverse proxy in front (recommended).
SCANNER_HOST=127.0.0.1
SCANNER_PORT=8080

# Public URL (used in CSP/cookie domain). Trailing slash NOT included.
SCANNER_PUBLIC_URL=https://scanner.example.com

# Secret key for session cookies + CSRF. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotate this on suspected compromise; existing sessions will be invalidated.
SCANNER_SECRET_KEY=

# Initial admin login (created on first start if no user exists).
# After first login, change the password via /settings; this var is ignored thereafter.
SCANNER_ADMIN_USERNAME=admin
SCANNER_ADMIN_PASSWORD=

# Trust X-Forwarded-* headers (set true ONLY if behind a trusted reverse proxy).
SCANNER_TRUST_PROXY=false

# Comma-separated CIDRs allowed to reach the API. Empty = allow all (rely on proxy ACL).
SCANNER_IP_ALLOWLIST=

# ───────── RadioReference ─────────
# https://www.radioreference.com/account/api  → request an appKey for your account.
RR_APP_KEY=
RR_USERNAME=
RR_PASSWORD=

# ───────── Storage ─────────
SCANNER_DATA_DIR=/var/lib/police-scanner
SCANNER_RECORDINGS_DIR=/var/lib/police-scanner/recordings
SCANNER_DB_PATH=/var/lib/police-scanner/db.sqlite
SCANNER_TR_CONFIG_PATH=/var/lib/police-scanner/trunk-recorder/config.json
SCANNER_TR_CAPTURE_DIR=/var/lib/police-scanner/trunk-recorder/captures

# ───────── trunk-recorder process control ─────────
SCANNER_TR_BINARY=/usr/local/bin/trunk-recorder
SCANNER_TR_SYSTEMD_UNIT=trunk-recorder.service

# ───────── MQTT (loopback only) ─────────
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_BASE=trunk-recorder

# ───────── Optional features ─────────
# Whisper transcription. Set to a model file path (e.g. models/ggml-small.en.bin) to enable.
WHISPER_MODEL_PATH=

# Audio retention in days. 0 = keep forever.
RECORDING_RETENTION_DAYS=30
