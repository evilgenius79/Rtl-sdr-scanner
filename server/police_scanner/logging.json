{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s %(levelname)s %(name)s :: %(message)s",
      "datefmt": "%Y-%m-%dT%H:%M:%S"
    }
  },
  "handlers": {
    "stderr": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr",
      "formatter": "default"
    }
  },
  "loggers": {
    "uvicorn": {"level": "INFO", "handlers": ["stderr"], "propagate": false},
    "uvicorn.access": {"level": "WARNING", "handlers": ["stderr"], "propagate": false},
    "uvicorn.error": {"level": "INFO", "handlers": ["stderr"], "propagate": false},
    "police_scanner": {"level": "INFO", "handlers": ["stderr"], "propagate": false}
  },
  "root": {"level": "INFO", "handlers": ["stderr"]}
}
