[Unit]
Description=Police Scanner web service (FastAPI)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=exec
User=scanner
Group=scanner
WorkingDirectory=/opt/police-scanner
EnvironmentFile=/etc/police-scanner/env
# Force HOME/XDG into the data dir so anything that writes to ~ lands in
# our writable area instead of /home (which is locked by ProtectHome).
Environment=HOME=/var/lib/police-scanner
Environment=XDG_CONFIG_HOME=/var/lib/police-scanner/.config
Environment=XDG_CACHE_HOME=/var/lib/police-scanner/.cache
# systemd creates /run/police-scanner on start, removes it on stop. Used
# for any short-lived runtime files (currently nothing, but available).
RuntimeDirectory=police-scanner
RuntimeDirectoryMode=0750
# Persistent state. systemd creates this if missing too (matches install-pi.sh).
StateDirectory=police-scanner
StateDirectoryMode=0750
ExecStart=/opt/police-scanner/.venv/bin/uvicorn \
    police_scanner.main:app \
    --host ${SCANNER_HOST} \
    --port ${SCANNER_PORT} \
    --proxy-headers \
    --forwarded-allow-ips 127.0.0.1 \
    --no-server-header \
    --log-config /opt/police-scanner/server/police_scanner/logging.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

# Hardening — see systemd.exec(5)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=true
PrivateDevices=false
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @swap @debug @mount @cpu-emulation @obsolete

# State directories. RuntimeDirectory/StateDirectory above already grant rw
# access to /run/police-scanner and /var/lib/police-scanner; this line is
# redundant but kept for clarity in case StateDirectory= is ever removed.
ReadWritePaths=/var/lib/police-scanner

# Allow controlling trunk-recorder unit only.
# Use polkit rule (see scripts/install-pi.sh) for unprivileged systemctl.
AmbientCapabilities=
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
