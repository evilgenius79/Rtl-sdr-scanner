[Unit]
Description=trunk-recorder (P25/conventional radio decoder)
After=network-online.target mosquitto.service
Wants=network-online.target
ConditionPathExists=/var/lib/police-scanner/trunk-recorder/config.json

[Service]
Type=exec
User=scanner
Group=scanner
SupplementaryGroups=plugdev
EnvironmentFile=/etc/police-scanner/env
# Force HOME / XDG paths into our state dir so GNU Radio's config writes land
# somewhere we actually allow writes (and survive restarts).
Environment=HOME=/var/lib/police-scanner
Environment=XDG_CONFIG_HOME=/var/lib/police-scanner/.config
Environment=XDG_CACHE_HOME=/var/lib/police-scanner/.cache
WorkingDirectory=/var/lib/police-scanner/trunk-recorder
ExecStart=/usr/local/bin/trunk-recorder --config=/var/lib/police-scanner/trunk-recorder/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
LimitNOFILE=65536

# Hardening — ProtectHome=tmpfs gives an empty writable tmpfs at /home so GNU
# Radio config writes to ~/.config/gnuradio don't fail, but the data is
# ephemeral. Persistent config + state lives under ReadWritePaths below.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

ReadWritePaths=/var/lib/police-scanner

[Install]
WantedBy=multi-user.target
