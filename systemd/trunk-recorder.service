[Unit]
Description=trunk-recorder (P25/conventional radio decoder)
After=network-online.target mosquitto.service
Wants=network-online.target
ConditionPathExists=/var/lib/police-scanner/trunk-recorder/config.json

[Service]
Type=exec
User=scanner
Group=scanner
SupplementaryGroups=plugdev
EnvironmentFile=/etc/police-scanner/env
WorkingDirectory=/var/lib/police-scanner/trunk-recorder
ExecStart=/usr/local/bin/trunk-recorder --config=/var/lib/police-scanner/trunk-recorder/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

ReadWritePaths=/var/lib/police-scanner

[Install]
WantedBy=multi-user.target
